# Copy this file to ".env.local" and paste in your two Supabase values.
# Find them in Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for admin-only server actions (creating users, resetting passwords,
# sending push notifications). Find it in Supabase: Project Settings -> API.
# NEVER expose this to the browser — server-only, used via lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Powers the in-app help assistant with real AI answers.
# Without this, the help widget still works using a built-in local FAQ — no cost, no setup.
# Get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Powers low-stock push notifications. Not a third-party account —
# just a keypair generated once locally. Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
